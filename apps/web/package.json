{
  "name": "@awebound/web",
  "version": "0.1.0",
  "private": true,
  "description": "Awebound storefront: Next.js App Router.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "archive:seed": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/archive-seed.ts",
    "archive:intake": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/archive-intake.ts",
    "archive:render-check": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/archive-render-check.ts",
    "archive:webhook": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/archive-webhook-fixture.ts",
    "grant:admin": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/grant-admin.ts",
    "revoke:admin": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/revoke-admin.ts"
  },
  "dependencies": {
    "@awebound/brand": "workspace:*",
    "@fontsource-variable/grenze-gotisch": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "supabase": "^2.120.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@awebound/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
