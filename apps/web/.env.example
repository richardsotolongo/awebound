# Copy to apps/web/.env.local.

# Public URL of this site (used for metadata, sitemap and auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Express API. The browser uses NEXT_PUBLIC_API_URL; server rendering may use a private
# address via API_URL (defaults to NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=

# Supabase (Project settings → API). The publishable key (or legacy anon key) is safe in the browser.
# Leave empty to run without accounts: sign-in shows "Accounts open soon".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
