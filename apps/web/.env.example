# Copy to apps/web/.env.local for development. On Vercel, set the same variables in the project
# (Settings → Environment Variables). Only public values belong in this file; never commit keys.

# Public URL of this site (metadata, sitemap, auth redirects, links and images in email).
NEXT_PUBLIC_SITE_URL=

# Fourthwall supplies the catalog and runs checkout. Required: Fourthwall admin → Settings →
# For developers → Storefront token.
FOURTHWALL_STOREFRONT_TOKEN=
# Optional. Checkout domain without https://; defaults to awebound-store-shop.fourthwall.com.
FOURTHWALL_CHECKOUT_DOMAIN=

# Supabase (Project settings → API). The URL and publishable key are public (they ship to the
# browser); the secret key never leaves the server. Without them accounts show "open soon" and
# contact messages and sign-ups aren't stored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend. Leave empty in development to print emails to the terminal; required in production.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_INBOX=

# Translation for Scripture quoted on the website (garment artwork keeps its own wording):
# NIV (default) or KJV. Website use of the NIV needs Biblica's written permission; set KJV to
# keep NIV text off the site until it is granted. Redeploy after changing it.
SCRIPTURE_TRANSLATION=
