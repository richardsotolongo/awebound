# Copy to apps/web/.env.local for development. On Vercel, set the same variables in the project
# (Settings → Environment Variables). Only public values belong in this file; never commit keys.

# Public URL of this site (canonical links, sitemap, llms.txt, share images, links in email).
# In production it must be the live address, https://www.awebound.store: a production build
# on Vercel fails while it is unset or localhost.
NEXT_PUBLIC_SITE_URL=

# Fourthwall supplies the catalog and runs checkout. Required: Fourthwall admin → Settings →
# For developers → Storefront token.
FOURTHWALL_STOREFRONT_TOKEN=
# Optional. Checkout domain without https://; defaults to awebound-store-shop.fourthwall.com.
FOURTHWALL_CHECKOUT_DOMAIN=

# Supabase (Project settings → API). The URL and publishable key are public (they ship to the
# browser); the secret key never leaves the server. Without them accounts show "open soon" and
# contact messages and sign-ups aren't stored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend. Leave empty in development to print emails to the terminal; required in production.
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_INBOX=

# PostHog analytics (PostHog → Project settings → Project token; public, it ships to the
# browser). Without the token nothing is sent. Set it for Production only on Vercel so preview
# deploys don't count as visits. The host is optional and defaults to PostHog US Cloud.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Translation for Scripture quoted on the website (garment artwork keeps its own wording):
# NIV (default) or KJV. Website use of the NIV needs Biblica's written permission; set KJV to
# keep NIV text off the site until it is granted. Redeploy after changing it.
SCRIPTURE_TRANSLATION=

# My Archive (orders, Founding Member seal, wallpapers). Each one is optional: the feature that
# needs it stays unavailable until it is set, and the admin Health page says which is missing.
# Fourthwall admin → Settings → For developers → Webhooks: the secret that signs order events.
FOURTHWALL_WEBHOOK_SECRET=
# Fourthwall admin → Settings → For developers → Open API → Create API user (Basic auth).
FOURTHWALL_API_USERNAME=
FOURTHWALL_API_PASSWORD=
# Any long random string; Vercel sends it as the bearer token with the daily reconcile cron.
CRON_SECRET=
# Optional. Private Supabase Storage bucket for wallpapers; defaults to archive-assets.
ARCHIVE_STORAGE_BUCKET=
