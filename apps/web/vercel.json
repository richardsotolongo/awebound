{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile --filter @awebound/web...",
  "buildCommand": "pnpm build",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/fourthwall/reconcile",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/indexnow",
      "schedule": "30 6 * * *"
    }
  ]
}
