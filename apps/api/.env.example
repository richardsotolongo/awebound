# Copy to apps/api/.env. Everything has a working default for local development except the
# Fourthwall storefront token, which is required, and the Supabase and Resend keys, which switch
# accounts, the inbox and email from offline mode to the real services.

PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser. "*" matches one DNS label
# (https://awebound-web-*.vercel.app covers Vercel previews).
WEB_ORIGIN=http://localhost:3000
# Public URL of the storefront, used in email links and images.
PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 behind a proxy (Vercel, Render, Railway, Fly) so rate limits see the real client IP.
TRUST_PROXY=0

# Fourthwall supplies the catalog and runs checkout. Required: Fourthwall admin → Settings →
# For developers → Storefront token.
FOURTHWALL_STOREFRONT_TOKEN=
# Optional. Checkout domain without https://; defaults to awebound-store-shop.fourthwall.com.
FOURTHWALL_CHECKOUT_DOMAIN=

# Supabase (Project settings → API). The secret key (or legacy service_role key) never leaves the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only for projects still on the legacy HS256 JWT secret. New projects verify tokens with JWKS.
SUPABASE_JWT_SECRET=

# Resend. Leave empty to print emails to the console instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="Awebound <noreply@awebound.store>"
CONTACT_INBOX=contact@awebound.store
