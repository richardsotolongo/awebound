# Copy to apps/api/.env. Everything has a working default for local development except the
# Supabase and Resend keys, which switch the API from offline mode to the real services.

PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser.
WEB_ORIGIN=http://localhost:3000
# Public URL of the storefront, used in email links and images.
PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 behind a proxy (Render, Railway, Fly, Vercel) so rate limits see the real client IP.
TRUST_PROXY=0

# Catalog source: "seed" serves packages/shared/src/seed (no database needed); "supabase" uses Postgres.
CATALOG_SOURCE=seed

# Supabase (Project settings → API). The secret key (or legacy service_role key) never leaves the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only for projects still on the legacy HS256 JWT secret. New projects verify tokens with JWKS.
SUPABASE_JWT_SECRET=

# Resend. Leave empty to print emails to the console instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="Awebound <hello@awebound.store>"
CONTACT_INBOX=contact@awebound.store

# Commerce provider: none until one is chosen (printful | printify | fourthwall | apliiq). See docs/TODOS.md.
COMMERCE_PROVIDER=none
