# Copy to apps/api/.env. Everything has a working default for local development except the
# Supabase and Resend keys, which switch the API from offline mode to the real services.

PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser. "*" matches one DNS label
# (https://awebound-web-*.vercel.app covers Vercel previews).
WEB_ORIGIN=http://localhost:3000
# Public URL of the storefront, used in email links and images.
PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 behind a proxy (Vercel, Render, Railway, Fly) so rate limits see the real client IP.
TRUST_PROXY=0

# Catalog source: "seed" serves packages/shared/src/seed (no database needed); "supabase" uses Postgres;
# "fourthwall" loads live products from the Fourthwall shop and merges them with the seed content by slug.
CATALOG_SOURCE=seed

# Supabase (Project settings → API). The secret key (or legacy service_role key) never leaves the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only for projects still on the legacy HS256 JWT secret. New projects verify tokens with JWKS.
SUPABASE_JWT_SECRET=

# Resend. Leave empty to print emails to the console instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="Awebound <hello@awebound.store>"
CONTACT_INBOX=contact@awebound.store

# Commerce provider: none (checkout shows "opens soon") or fourthwall (hosted checkout).
# printful | printify | apliiq are reserved names, not built. See docs/TODOS.md.
COMMERCE_PROVIDER=none

# Fourthwall (admin → Settings → For developers). The token is required when CATALOG_SOURCE or
# COMMERCE_PROVIDER is fourthwall; the checkout domain (no https://) when COMMERCE_PROVIDER is fourthwall.
FOURTHWALL_STOREFRONT_TOKEN=
FOURTHWALL_CHECKOUT_DOMAIN=
FOURTHWALL_CURRENCY=USD
FOURTHWALL_API_URL=https://storefront-api.fourthwall.com/v1
