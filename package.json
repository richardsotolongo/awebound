{
  "name": "awebound",
  "private": true,
  "description": "Awebound storefront: Next.js web app, Express API, Fourthwall commerce, Supabase auth and data.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @awebound/web --filter @awebound/api dev",
    "dev:web": "pnpm --filter @awebound/web dev",
    "dev:api": "pnpm --filter @awebound/api dev",
    "build": "pnpm -r build",
    "start": "pnpm --parallel --filter @awebound/web --filter @awebound/api start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
