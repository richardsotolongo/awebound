# Awebound — every environment variable in one place.
#
# Two apps, two sets of variables:
#   - Local development: copy the WEB block to apps/web/.env.local and the API block to
#     apps/api/.env (or copy apps/web/.env.example and apps/api/.env.example, which hold the same
#     variables with local defaults). Each app reads only its own file.
#   - Vercel: two projects from this repo. Paste the WEB block into the project whose Root
#     Directory is apps/web, and the API block into the project whose Root Directory is apps/api
#     (Project → Settings → Environment Variables). See docs/DEPLOYMENT.md.
#
# Values below are for production on awebound.store. Never commit real keys: .env files are
# git-ignored; only *.env.example is tracked.

# ─────────────────────────────────────────────────────────────────────────────
# WEB  (apps/web · Vercel project "awebound-web" · domain awebound.store)
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the storefront (metadata, sitemap, auth redirects).
NEXT_PUBLIC_SITE_URL=https://awebound.store

# The API, as the browser reaches it.
NEXT_PUBLIC_API_URL=https://api.awebound.store
# Optional: a different address for server rendering. Defaults to NEXT_PUBLIC_API_URL.
API_URL=

# Supabase (Project settings → API). The publishable key is safe in the browser.
# Leave both empty to run without accounts (sign-in shows "Accounts open soon").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# API  (apps/api · Vercel project "awebound-api" · domain api.awebound.store)
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info
# Only used by `pnpm dev` / `pnpm start`; Vercel ignores it.
PORT=4000

# Origins allowed to call the API from a browser, comma-separated. "*" stands for one DNS label,
# so the second entry covers Vercel preview deployments of the web project.
WEB_ORIGIN=https://awebound.store,https://www.awebound.store,https://awebound-web-*.vercel.app
# Public URL of the storefront, used in email links and images.
PUBLIC_SITE_URL=https://awebound.store
# 1 behind a proxy (Vercel, Render, Railway, Fly) so rate limits see the real client IP.
TRUST_PROXY=1

# Where the catalog comes from:
#   seed       packages/shared/src/seed (no database, no provider)
#   supabase   the Postgres catalog (supabase/migrations)
#   fourthwall live products, prices, stock and photos from the Fourthwall shop, merged with the
#              site's brand content by slug (see docs/ARCHITECTURE.md → Fourthwall)
CATALOG_SOURCE=fourthwall

# Who takes payment and fulfills: none | fourthwall (printful | printify | apliiq not built yet).
COMMERCE_PROVIDER=fourthwall

# Fourthwall (admin → Settings → For developers → Storefront token). Required when either
# CATALOG_SOURCE or COMMERCE_PROVIDER is fourthwall.
FOURTHWALL_STOREFRONT_TOKEN=
# The shop's checkout domain, without https:// (your-shop.fourthwall.com, or a custom domain such
# as shop.awebound.store once it is connected in Fourthwall). Required for COMMERCE_PROVIDER=fourthwall.
FOURTHWALL_CHECKOUT_DOMAIN=
FOURTHWALL_CURRENCY=USD
# Only change for testing against a mock.
FOURTHWALL_API_URL=https://storefront-api.fourthwall.com/v1

# Supabase (Project settings → API). The secret key never leaves the server.
# Needed for accounts (/me), stored contact messages and drop-note sign-ups, and CATALOG_SOURCE=supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only for projects still on the legacy HS256 JWT secret. New projects verify tokens with JWKS.
SUPABASE_JWT_SECRET=

# Resend. Required when NODE_ENV=production (the contact form emails CONTACT_INBOX).
# The awebound.store domain must be verified in Resend for EMAIL_FROM to send.
RESEND_API_KEY=
EMAIL_FROM="Awebound <hello@awebound.store>"
CONTACT_INBOX=contact@awebound.store
